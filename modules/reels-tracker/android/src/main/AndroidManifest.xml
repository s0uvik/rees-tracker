<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Used by the service to post the "daily limit reached" notification. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.reelstracker.ReelsAccessibilityService"
      android:exported="true"
      android:label="@string/reels_tracker_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/reels_accessibility_config" />
    </service>
  </application>
</manifest>
